# ======================================
# Task Manager - Environment Configuration
# ======================================
# Copy this file to .env and fill in your values
# For Railway deployment, these variables should be set in Railway dashboard

# ======================================
# Node Environment
# ======================================
NODE_ENV=development

# ======================================
# Server Configuration
# ======================================
PORT=5000
CLIENT_PORT=5173

# ======================================
# Database Configuration
# For Railway: Use DATABASE_URL (auto-provided by Railway PostgreSQL)
# For Local: Use POSTGRES_URL or leave empty for SQLite
# ======================================
# Railway will auto-provide this - no need to set manually
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Alternative PostgreSQL Configuration (if not using DATABASE_URL)
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=task_manager_prod
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ======================================
# JWT Configuration
# ⚠️ IMPORTANT: Generate strong random strings for production
# Use: openssl rand -hex 32
# ======================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ======================================
# CORS & Client Configuration
# ======================================
# For Railway: Should be your deployed client URL
# Example: https://task-manager-client.up.railway.app
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000

# ======================================
# App Information
# ======================================
VITE_APP_NAME=Task Manager
APP_VERSION=1.0.0

# ======================================
# Optional: Logging & Debugging
# ======================================
DEBUG=false
LOG_LEVEL=info
