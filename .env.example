# ========================================
# Environment Configuration (Template)
# ========================================
# Copy this file to .env and fill in your values
# For local development, defaults should work

# ========================================
# Database Configuration
# ========================================
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=password123
POSTGRES_DB=task_manager_dev
POSTGRES_PORT=5432

# For production, use: postgresql://user:password@host:port/dbname
# For local Docker: postgresql://taskmanager:password123@postgres:5432/task_manager_dev
POSTGRES_URL=postgresql://taskmanager:password123@postgres:5432/task_manager_dev

# ========================================
# Backend (Node.js/Express)
# ========================================
NODE_ENV=development
PORT=5000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ========================================
# Frontend (React/Vite)
# ========================================
VITE_API_URL=http://localhost:5000
VITE_APP_NAME=Task Manager

CLIENT_PORT=5173

# ========================================
# Environment Type
# ========================================
NODE_ENV=development

# ========================================
# Optional: Email Configuration (for future use)
# ========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ========================================
# Optional: S3 / File Storage (for future use)
# ========================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1
